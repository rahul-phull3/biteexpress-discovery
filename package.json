{
  "name": "biteexpress-discovery",
  "version": "0.1.0",
  "description": "BiteExpress restaurant discovery API: NestJS on MongoDB",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:int": "jest --config ./test/jest-int.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "db:up": "docker compose up -d --wait --wait-timeout 180 mongodb",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:logs": "docker compose logs -f mongodb",
    "db:shell": "docker compose exec mongodb mongosh biteexpress",
    "db:inspect": "docker compose exec -T mongodb mongosh biteexpress --quiet --file /scripts/inspect.js",
    "db:validator-demo": "docker compose exec -T mongodb mongosh biteexpress --quiet --file /scripts/validator-demo.js",
    "db:explain": "docker compose exec -T mongodb mongosh biteexpress --quiet --file /scripts/explain.js",
    "db:import": "docker compose run --rm --build importer",
    "import": "nest build && node dist/importer/main.js",
    "import:dry": "nest build && node dist/importer/main.js --dry-run",
    "import:fixes": "nest build && node dist/importer/build-text-fixes.main.js",
    "stack:up": "docker compose up -d --build --wait --wait-timeout 300"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "csv-parse": "^7.0.3",
    "mongodb": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
