# Copy to .env for local runs:  Copy-Item .env.example .env   (PowerShell)
# Every value below is also the built-in default, so you only need a .env to change one.
# The app validates these at boot (src/config/env.schema.ts), so a typo fails fast.

NODE_ENV=development
PORT=3000

# MongoDB. The default targets the Atlas Local container from docker-compose.yml.
# Keep directConnection=true for that container. For Atlas, use your mongodb+srv:// string.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=biteexpress

# The tenant that owns the restaurants the importer loads (1 to 64 letters, digits,
# underscores or hyphens). The importer's --tenant option overrides it.
DEFAULT_TENANT_ID=biteexpress

# The time limit of every MongoDB read, in milliseconds (100 to 60000). A read that
# runs longer is stopped by the server and answered with 503 and a Retry-After header.
READ_TIMEOUT_MS=2000

# How the leftover words of a search sentence ("vada pav") are matched:
#   atlas  Atlas Search (typo tolerant); falls back to rules, and says so in the answer,
#          while the search index is not ready
#   rules  plain text matching on the name and the area, always
SEARCH_ENGINE=atlas

# The Swagger UI at /docs and the OpenAPI document at /docs/openapi.json.
# Set to false for a deployment that is open to the internet.
DOCS_ENABLED=true

# Read by docker compose only, not by the app. If you change MONGO_PORT, change the
# port in MONGODB_URI to the same number.
MONGO_PORT=27017
API_PORT=3000
# Which address the API port is published on. 127.0.0.1 keeps it on this machine;
# use 0.0.0.0 on a cloud VM (and put TLS in front of it).
API_BIND=127.0.0.1

# SonarQube (docker-compose.sonar.yml): the port, and the token you create in its UI.
SONAR_PORT=9000
SONAR_TOKEN=
